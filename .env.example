# Copiar a .env y rellenar valores reales
# cp .env.example .env

# Base de datos Neon Postgres (Prisma)
# Obtener connection string en https://console.neon.tech
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"

# Secret para proteger /api/sync en producción (Vercel Cron)
# Generar con: openssl rand -hex 32
# Si no se define, /api/sync permite requests (solo desarrollo)
# CRON_SECRET=

# OpenAI (opcional): para "Explicación con IA" en la página de detalle del release
# Sin esta variable, el botón "Generar explicación" mostrará un mensaje indicando configurarla
# OPENAI_API_KEY=

# Redis (opcional): caché delante de Postgres para reducir latencia y costos
# Proveedores recomendados: Upstash (https://upstash.com) · Redis Cloud · local (redis://localhost:6379)
# Sin esta variable, la app funciona igual pero cada request consulta Postgres directamente
# REDIS_URL=redis://localhost:6379

# Resend (newsletter): envía el digest semanal a los suscriptores
# API key en: https://resend.com/api-keys
# RESEND_API_KEY=
# RESEND_FROM=Main Branch <newsletter@mainbranch.cl>
# NEXT_PUBLIC_SITE_URL=https://www.mainbranch.cl
