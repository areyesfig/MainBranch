// Prisma schema - Neon Postgres
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Release {
  id                   String   @id @default(cuid())
  sourceId             String   // ID de la fuente (rss-nextjs-blog, api-github-etc)
  technology           String
  version              String
  releaseDate          DateTime
  tldr                 String
  description          String   @default("")
  breakingChange       Boolean  @default(false)
  features             String?  // JSON array
  improvements         String?  // JSON array
  bugFixes             String?  // JSON array
  breakingChanges      String?  // JSON array
  officialUrl          String?
  tags                 String?  // JSON array
  stack                String?
  category             String?
  previousVersion      String?
  estimatedMigrationTime Int?
  migrationComplexity  String?  // low, medium, high, critical
  impactScore          Int?     @default(0)
  votes                Int      @default(0)
  tweeted              Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([technology, version])
  @@index([stack])
  @@index([category])
  @@index([releaseDate])
  @@index([votes])
}

model Subscriber {
  id               String    @id @default(cuid())
  email            String    @unique
  token            String    @unique @default(cuid()) // confirm + unsubscribe
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([email])
  @@index([token])
}

model Digest {
  id            String   @id @default(cuid())
  period        String   // "weekly" | "monthly"
  startDate     DateTime
  endDate       DateTime
  content       String   // Markdown generado por IA
  technologies  String   // JSON array
  releaseCount  Int      @default(0)
  generatedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([period, startDate])
  @@index([period])
  @@index([endDate])
}
